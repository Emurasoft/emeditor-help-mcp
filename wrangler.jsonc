{
	"name": "emeditor-help-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-23",
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	},
	"routes": [
		{
			"pattern": "help.emeditor.com/mcp*",
			"zone_name": "emeditor.com"
		}
	]
}