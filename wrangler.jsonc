{
	"name": "emeditor-help-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "default",
			"remote": true
		}
	],
	"ratelimits": [
		{
			"name": "IP_RATE_LIMITER",
			"namespace_id": "11",
			"simple": {
				// 10 requests per 10 seconds
				"limit": 10,
				"period": 10
			}
		},
		{
			"name": "SEARCH_RATE_LIMITER",
			"namespace_id": "12",
			"simple": {
				// 10 requests per minute
				"limit": 10,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"placement": {
		"mode": "smart"
	},
	"routes": [
		{
			"pattern": "help.emeditor.com/mcp*",
			"zone_name": "emeditor.com"
		}
	]
}